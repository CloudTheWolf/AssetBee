# ============================================================
# Application
# ============================================================

APP_NAME="AssetBee Custodian"
APP_ENV=production
APP_KEY=base64:YOUR_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://mysite.com

# Used by Traefik router rule
DOMAIN=mysite.com

# Docker image tag/version
APP_VERSION=dev
CLOUD_HOSTED=true
# Run Laravel migrations when the app container starts
RUN_MIGRATIONS=false


# ============================================================
# Logging
# ============================================================

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info


# ============================================================
# Database
#
# When using:
#   --profile with-sql
#
# leave DB_HOST as:
#   mariadb
#
# When using an external MariaDB/MySQL server,
# change DB_HOST accordingly.
# ============================================================

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306

DB_DATABASE=assetbee
DB_USERNAME=assetbee_user

# CHANGE THESE
DB_PASSWORD=
DB_ROOT_PASSWORD=


# ============================================================
# Redis
#
# When using:
#   --profile with-redis
#
# leave REDIS_HOST as:
#   redis
#
# For an external Redis server, change REDIS_HOST.
# ============================================================

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Memory limit passed to the bundled Redis container
REDIS_MAXMEMORY=256mb


# ============================================================
# Cache
# ============================================================

CACHE_STORE=redis
CACHE_PREFIX=assetbee_cache


# ============================================================
# Sessions
# ============================================================

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax


# ============================================================
# Queue
# ============================================================

QUEUE_CONNECTION=redis


# ============================================================
# Broadcasting
# ============================================================

BROADCAST_CONNECTION=log


# ============================================================
# Filesystem
# ============================================================

FILESYSTEM_DISK=local


# ============================================================
# Mail
#
# Replace with your SMTP provider.
# ============================================================

MAIL_MAILER=smtp
# MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mysite.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls


# ============================================================
# Laravel Octane / FrankenPHP
# ============================================================

OCTANE_SERVER=frankenphp
# When using reverse proxy that handles certs (Eg Traefik/HAProxy), keep this set to false
OCTANE_HTTPS=false


# ============================================================
# Proxy / HTTPS
# ============================================================

TRUSTED_PROXIES=*


# ============================================================
# Laravel internals
# ============================================================

BCRYPT_ROUNDS=12

PHP_CLI_SERVER_WORKERS=4


# ============================================================
# Vite / Frontend
# ============================================================

VITE_APP_NAME="${APP_NAME}"


# ============================================================
# Optional AWS / S3
#
# Only required if AssetBee uses S3-compatible storage.
# ============================================================

#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=eu-west-2
#AWS_BUCKET=
#AWS_USE_PATH_STYLE_ENDPOINT=false


# ============================================================
# Optional external services
# ============================================================

# Example:
#
# STRIPE_KEY=
# STRIPE_SECRET=
#
# SENTRY_LARAVEL_DSN=
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
