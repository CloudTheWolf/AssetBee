{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types","bun"],
    "baseUrl": ".",
    "paths": {
      "@config/*": ["../../packages/config/*"],
      "@types/*": ["../../packages/types/*"]
    },
    "allowSyntheticDefaultImports": true
  }
}
